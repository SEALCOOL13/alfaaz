{
  "manifest_version": 3,
  "name": "Alfaaz — Urdu & Arabic text",
  "short_name": "Alfaaz",
  "version": "2.0.0",
  "description": "Your font, size, letter spacing and line height for Urdu, Arabic and Persian text on every website.",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Alfaaz",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Turn Alfaaz on or off for this site"
    },
    "compare": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Show the original text in this tab (press again to restyle)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shadow-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/common.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
